circuit updateShieldedReserve(isMappingToken: Boolean,token: Bytes<32>, delta: Uint<128>, isAdd: Boolean): [] {
  assert(delta > 0, "delta must be positive");
  const oldAmount = reserveOfAllShieldedToken.member(disclose(token))? reserveOfAllShieldedToken.lookup(disclose(token)).total : 0;
  assert(isAdd || oldAmount >= delta, "delta must be less than or equal to oldAmount");

  const newAmount = isAdd ? oldAmount + delta : oldAmount - delta;

  if(newAmount == 0){
    reserveOfAllShieldedToken.remove(disclose(token));
  }else{
    reserveOfAllShieldedToken.insert(disclose(token),ReserveOfToken{total: newAmount as Uint<128>,isMappingToken: isMappingToken});
  }
}

circuit updateUnshieldedReserve(isMappingToken: Boolean,token: Bytes<32>, delta: Uint<128>, isAdd: Boolean): [] {
  assert(delta > 0, "delta must be positive");
  const oldAmount = reserveOfAllUnshieldedToken.member(disclose(token))? reserveOfAllUnshieldedToken.lookup(disclose(token)).total : 0;
  assert(isAdd || oldAmount >= delta, "delta must be less than or equal to oldAmount");

  const newAmount = isAdd ? oldAmount + delta : oldAmount - delta;

  if(newAmount == 0){
    reserveOfAllUnshieldedToken.remove(disclose(token));
  }else{
    reserveOfAllUnshieldedToken.insert(disclose(token),ReserveOfToken{total: newAmount as Uint<128>,isMappingToken: isMappingToken});
  }
}

