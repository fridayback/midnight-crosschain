export circuit userRechargeForFee(amount: Uint<128>): [] {

  receiveUnshielded(nativeToken(),disclose(amount));
  updateUserFee(ownPublicKey(), disclose(amount), true);
}

export circuit userFeeWithdrawRequest(receiptor: UserAddress):[] {
  userFeeWithdrawAddress.insert(ownPublicKey(),disclose(receiptor));
}

//TODO: implement withdraw cross-chain asserts or fee for user
export circuit userClaimCoin(id: Bytes<32>): [] {
  assert(coinToBeClaimed.member(disclose(id)), "coin not exists");
  const claimCoinInfo = coinToBeClaimed.lookup(disclose(id));
  assert(claimCoinInfo.receiver == ownPublicKey(), "not receiver");
  sendShielded(claimCoinInfo.coin, left<ZswapCoinPublicKey, ContractAddress>(claimCoinInfo.receiver), claimCoinInfo.coin.value);
  coinToBeClaimed.remove(disclose(id));
}

export circuit userClaimMappingToken(id: Bytes<32>): [] {
  assert(mappingTokenToBeClaim.member(disclose(id)), "mapping token not exists");
  const claimMappingTokenInfo = mappingTokenToBeClaim.lookup(disclose(id));
  assert(claimMappingTokenInfo.receiver == ownPublicKey(), "not receiver");
  nonce = evolveNonce(crossCounter as Field as Uint<64>,nonce);
  mintShieldedToken(claimMappingTokenInfo.domainSep,claimMappingTokenInfo.amount as Uint<64>,nonce, left<ZswapCoinPublicKey, ContractAddress>(claimMappingTokenInfo.receiver));
  mappingTokenToBeClaim.remove(disclose(id));
}

circuit updateUserFee(user: ZswapCoinPublicKey, delta: Uint<128>,isAdd: Boolean): [] {
  assert(delta > 0, "delta must be positive");
  const oldBalance = userFeeBalance.member(ownPublicKey())?userFeeBalance.lookup(ownPublicKey()) : 0;
  assert( isAdd || oldBalance >= delta, "userFeeBalance not enough");
  
  const newBalance = isAdd?(oldBalance + delta) : (oldBalance - delta);
  if(newBalance == 0){
    userFeeBalance.remove(ownPublicKey());
  }else{
    userFeeBalance.insert(ownPublicKey(), newBalance as Uint<128>);
  }
}
