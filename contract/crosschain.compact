export circuit smgMint(uniqueId: Bytes<32>
  , smgId: Bytes<32>
  , tokenPairId: Uint<32>
  , amount: Uint<128>
  , fee: Uint<128>
  , toAddr: ZswapCoinPublicKey
  , ttl: Uint<64>): [] {
  addCrossProposal(disclose(uniqueId), disclose(smgId), disclose(tokenPairId), disclose(amount), disclose(toAddr), disclose(fee), disclose(ttl), true);
}

export circuit userBurn(smgId: Bytes<32>, toAddr: Opaque<"string">, tokenPairId: Uint<32>, coin: CoinInfo): [] {
  assert(tokenPairs.member(disclose(tokenPairId)),"tokenpairId not exists");
  const tokenPair = tokenPairs.lookup(disclose(tokenPairId));
  assert(tokenPair.midnigthTokenAccount == disclose(coin.color), "token color not match");
  const contractFee = getFee(disclose(tokenPairId));
  
  // nonce = evolveNonce(crossCounter as Field as Uint<64>,nonce);
  // const color = tokenType(tokenPair.midnigthTokenAccount,kernel.self());
  // const coin = CoinInfo{color: tokenPair.midnigthTokenAccount, value: disclose(amount), nonce: nonce};
  receive(disclose(coin));
  sendImmediate(disclose(coin), burnAddress(), disclose(coin.value));

    // record the crosschain info
  latestOutBoundCrosstxInfo = CrossOutBound{
    smgId: disclose(smgId)
    , fromAddr: ownPublicKey()
    , toAddr: disclose(toAddr)
    , tokenPairId: disclose(tokenPairId)
    , tokenAccount: tokenPair.midnigthTokenAccount
    , amount: disclose(coin.value)
    , fee: contractFee
    , nonce: crossCounter as Field as Uint<128>
  };

  if(contractFee > 0){
    updateUserFee(ownPublicKey(), contractFee, false);
    updateReserve(false,nativeToken(), contractFee, true);
  }

  // crossCounter.increment(1);
}

circuit addCrossProposal(
  uniqueId: Bytes<32>
  , smgId: Bytes<32>
  , tokenPairId: Uint<32>
  , amount: Uint<128>
  , toAddr: ZswapCoinPublicKey
  , fee: Uint<128>
  , ttl: Uint<64>
  , isMappingToken: Boolean
): [] {
  assert(crossProposalHis.member(disclose(uniqueId)) == false, "crossTx has finished");
  assert(smgTxSigners.member(ownPublicKey()), "not smg member");

  if(crossProposal.member(disclose(uniqueId))){
     if(blockTimeLt(crossProposal.lookup(disclose(uniqueId)).ttl)){
       assert(false,"proposal exists");
     }else{
       crossProposal.remove(disclose(uniqueId));
       crossProposalVoters.remove(disclose(uniqueId));
     }
  }
  assert( blockTimeLt(disclose(ttl)), "ttl expired");
  assert(tokenPairs.member(disclose(tokenPairId)),"tokenpairId not exists");

  const tokenPair = tokenPairs.lookup(disclose(tokenPairId));
  
  const newCrossProposal = CrossProposal{ 
    smgId: disclose(smgId)
    , token: isMappingToken?tokenPair.domainSep :tokenPair.midnigthTokenAccount
    , tokenPairId: disclose(tokenPairId)
    , isMappingToken: isMappingToken
    , amount: disclose(amount)
    , fee: disclose(fee)
    , toAddr: disclose(toAddr)
    , ttl: disclose(ttl)
    };

  //TODO: need to check add the same proposal again
 
  crossProposal.insert(disclose(uniqueId),newCrossProposal);
  crossProposalVoters.insert(disclose(uniqueId),default<Set<Uint<8>>>);

  voteCrossProposal(disclose(uniqueId));
  crossCounter.increment(1);
}

export circuit voteMultiCrossProposal(uniqueIds: Vector<5, Bytes<32>>): [] {
  for (const uniqueId of disclose(uniqueIds)) {
    if(uniqueId != default<Bytes<32>>) {
      voteCrossProposal(uniqueId);
    }
  }
}

export circuit voteCrossProposal(uniqueId: Bytes<32>): [] {
  assert(smgTxSigners.member(ownPublicKey()), "not smg member");
  assert(crossProposal.member(disclose(uniqueId)), "proposal not exists");

  const proposal = crossProposal.lookup(disclose(uniqueId));
  

  // if ttl is expired and not enough voters, remove the proposal
  if(blockTimeGte(proposal.ttl)){
    crossProposal.remove(disclose(uniqueId));
    crossProposalVoters.remove(disclose(uniqueId));
    return;
  }

  assert(crossProposalVoters.lookup(disclose(uniqueId)).size() < smgPKThreshold, "already passed");

  const voterIndex = smgTxSigners.lookup(ownPublicKey());
  assert(!crossProposalVoters.lookup(disclose(uniqueId)).member(voterIndex), "already voted");

  crossProposalVoters.lookup(disclose(uniqueId)).insert(voterIndex);

  if(crossProposalVoters.lookup(disclose(uniqueId)).size() >= smgPKThreshold && proposal.fee > 0){
    updateReserve(proposal.isMappingToken,proposal.token,proposal.fee,true);
  }
}

export circuit executeMultiCrossProposal(mutiEx: Vector<5,ExecuteCrossProposalInfo>): [] {
  currentExecuteCrossProposal.resetToDefault();
  for (const exCp of disclose(mutiEx)) {
    if(exCp.uniqueId != default<Bytes<32>>) {
      executeCrossProposal(exCp.uniqueId, exCp.coinIndex);
    }
  }
}

circuit executeCrossProposal(uniqueId: Bytes<32>, coinIndex: Uint<128>): [] {
  assert(mergeWorker == ownPublicKey(), "only mergeWorker can executeCrossProposal ");
  assert( crossProposal.member(disclose(uniqueId)),"crossproposal not exists");
  assert(crossProposalVoters.lookup(disclose(uniqueId)).size() >= smgPKThreshold, "not enough votes");
  const proposal = crossProposal.lookup(disclose(uniqueId));

  if(proposal.isMappingToken == false){
    assert( treasuryCoins.member(disclose(coinIndex)),"coin not exists");
    const coinInput = treasuryCoins.lookup(disclose(coinIndex));
    assert(coinInput.value == proposal.amount, "coin value not match");
    
    coinToBeClaimed.insert(disclose(uniqueId),ClaimCoinInfo{coin:coinInput,receiver:proposal.toAddr});
    treasuryCoins.remove(disclose(coinIndex));
  }else{
    mappingTokenToBeClaim.insert(disclose(uniqueId),ClaimMappingTokenInfo{domainSep:proposal.token,amount:proposal.amount,receiver:proposal.toAddr});
  }

  crossProposalHis.insert(disclose(uniqueId),proposal.ttl);
  crossProposal.remove(disclose(uniqueId));
  crossProposalVoters.remove(disclose(uniqueId));
  currentExecuteCrossProposal.insert(disclose(uniqueId));
}


circuit addTreasuryCoin(coin: CoinInfo): [] {
    // index 0 is reserved for invalid cion
  treasuryCoinCounter.increment(1);
  treasuryCoins.insertCoin(treasuryCoinCounter as Field as Uint<128>, coin, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  
}

// if fee is 0 ,cross fee is specified by feeConfig
circuit getFee(tokenPairId: Uint<32>): Uint<128> {
  const tokenPair = tokenPairs.lookup(disclose(tokenPairId));
  if(tokenPair.fee == 0) {
    if(feeCommonConfig.member(tokenPair.toChainId)){
      return feeCommonConfig.lookup(tokenPair.toChainId);
    }else {
      return 0;
    }
  } else {
    return tokenPair.fee;
  }
}

