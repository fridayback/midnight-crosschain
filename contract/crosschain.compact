// cross tx related state
export ledger crossCounter: Counter;
export ledger nonce: Bytes<32>;
export ledger smgTxSigners: Map<ZswapCoinPublicKey, Uint<8>>;
export ledger latestOutBoundCrosstxInfo: CrossOutBound;
// export ledger crossProposalHis: Map<Bytes<32>, Uint<128>>;
