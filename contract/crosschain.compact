export circuit withdrawReserveOfNativeToken(token: Bytes<32>,coinIndex: Uint<128>): [] {
  assert(ownPublicKey() == mergeWorker, "only mergeWorker can withdrawReserveOfNativeToken");
  assert(reserveOfAllToken.member(disclose(token)), "fee of specified token not exists");
  const reserveInfo = reserveOfAllToken.lookup(disclose(token));
  assert(reserveInfo.isMappingToken == false, "only native token can be executed");

  const coinInput = treasuryCoins.lookup(disclose(coinIndex));
  assert(coinInput.value <= reserveInfo.total, "not enough reserve");
  const resultSend = send(coinInput, left<ZswapCoinPublicKey, ContractAddress>(feeReceiver), coinInput.value);

  treasuryCoins.remove(disclose(coinIndex));
  updateReserve(false,token,disclose(coinInput.value),false);
}

export circuit  withdrawReserveOfMappingToken(domainSep: Bytes<32>): [] {
  assert(ownPublicKey() == mergeWorker, "only mergeWorker can withdrawReserveOfMappingToken");
  assert(reserveOfAllToken.member(disclose(domainSep)), "reserver of specified domainSep not exists");
  const reserveInfo = reserveOfAllToken.lookup(disclose(domainSep));
  assert(reserveInfo.isMappingToken == true, "only mapping token can be executed");

  nonce = evolveNonce(crossCounter as Field as Uint<64>,nonce);
  mintToken(disclose(domainSep), reserveInfo.total as Uint<64>, nonce,left<ZswapCoinPublicKey, ContractAddress>(feeReceiver));
  updateReserve(true,domainSep,reserveInfo.total,false);
}
