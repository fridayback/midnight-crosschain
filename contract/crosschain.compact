export circuit addReserve(coin: CoinInfo): [] {
  receive(disclose(coin));
  addTreasuryCoin(disclose(coin));
  updateReserve(false, disclose(coin.color), disclose(coin.value), true);
}

circuit updateReserve(isMappingToken: Boolean,token: Bytes<32>, delta: Uint<128>, isAdd: Boolean): [] {
  assert(delta > 0, "delta must be positive");
  const oldAmount = reserveOfAllToken.member(disclose(token))? reserveOfAllToken.lookup(disclose(token)).total : 0;
  assert(isAdd || oldAmount >= delta, "delta must be less than or equal to oldAmount");

  const newAmount = isAdd ? oldAmount + delta : oldAmount - delta;

  if(newAmount == 0){
    reserveOfAllToken.remove(disclose(token));
  }else{
    reserveOfAllToken.insert(disclose(token),ReserveOfToken{total: newAmount as Uint<128>,isMappingToken: isMappingToken});
  }
}

export circuit approveUserWithdrawFee(user: ZswapCoinPublicKey, coinApprove: CoinInfo): []{
  assert(ownPublicKey() == mergeWorker, "only mergeWorker can approveUserWithDrawFee");//TODO: who has the right to approve
  assert(disclose(coinApprove.color) == nativeToken(),"wrong coin color");
  assert(userFeeBalance.member(disclose(user)), "userFeeBalance not exists");
  const userFeeBalanceInfo = userFeeBalance.lookup(disclose(user));
  assert(userFeeBalanceInfo >= disclose(coinApprove.value), "coinApprove.value must <= userFeeBalance");

  receive(disclose(coinApprove));
  addTreasuryCoin(disclose(coinApprove));

  const coinIndex = treasuryCoinCounter as Field as Uint<128>;
  const coinOfTreasury = treasuryCoins.lookup(coinIndex);
  updateUserFee(user, disclose(coinApprove.value), false);
  updateReserve(false, disclose(coinApprove.color), disclose(coinApprove.value), true);

  nonce = evolveNonce(crossCounter as Field as Uint<64>,nonce);
  coinToBeClaimed.insert(nonce,ClaimCoinInfo{coin: coinOfTreasury, receiver: disclose(user)});
  treasuryCoins.remove(coinIndex);
}

