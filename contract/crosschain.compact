pragma language_version >= 0.15.0;

import CompactStandardLibrary;


export { CoinInfo, QualifiedCoinInfo, CurvePoint, ZswapCoinPublicKey,TokenPairInfo,FeeConfig,ProposalType,Proposal,CrossOutBound, CrossProposal}


// cross tx related state
export ledger crossCounter: Counter;
export ledger nonce: Bytes<32>;
export ledger smgTxSigners: Map<ZswapCoinPublicKey, Uint<8>>;
export ledger latestOutBoundCrosstxInfo: CrossOutBound;
export ledger crossProposalHis: Map<Bytes<32>, Uint<128>>;
export ledger currentExecuteCrossProposal: Bytes<32>;

// treasury related state
export ledger treasuryCoins: Map<Uint<128>, QualifiedCoinInfo>;
export ledger treasuryCoinCounter: Counter;
export ledger accFeeOfAllToken: Map<Bytes<32>, AccFeeOfToken>;

// token related state
export ledger tokenPairs: Map<Uint<32>, TokenPairInfo>;
export ledger tokenManager: ZswapCoinPublicKey;

//fee related state  fromChainId-> toChainId -> fee
export ledger feeCommonConfig: Map<Uint<32>, Uint<128>>;
export ledger feeReceiver: ZswapCoinPublicKey;

// smg related state
export ledger smgPubkeys: Map<Uint<8>,CurvePoint>;
export ledger smgPubkeysToIndex: Map<CurvePoint, Uint<8>>;
export ledger smgPKThreshold: Uint<8>;
// export ledger smgPKCount: Uint<8>;

// admin related state
export ledger admins: Map<ZswapCoinPublicKey, Boolean>;
export ledger adminThreshold: Uint<8>;

//proposal related state
export ledger proposalId: Counter;
export ledger proposals: Map<Uint<32>, Proposal>;
export ledger currentExcuteProposalId: Uint<32>;
export ledger proposalVoters: Map<Uint<32>, Set<ZswapCoinPublicKey>>;

export ledger crossProposal: Map<Bytes<32>,CrossProposal>;
export ledger crossProposalVoters: Map<Bytes<32>, Set<Uint<8>>>;

export ledger nativeTokenReceived: Uint<128>;

export enum ProposalType{
  AddAdmin,
  RemoveAdmin,
  UpdateFeeReceiver,
  UpdateTokenManager,
  UpdateAdminThreshold,
  UpdateSMGPKThreshold,
  UpdateFeeCommonConfig,
  SetSmgPKS
}

export struct AccFeeOfToken{
  totalFee: Uint<128>;
  isMappingToken: Boolean;
}

export struct FeeConfig{
  chainId: Uint<32>;
  fee: Uint<128>;
}

export struct Proposal{
  type: ProposalType;
  addr: ZswapCoinPublicKey;
  threshold: Uint<128>;
  feeConfig: FeeConfig;
  smgPubkeys: Vector<2, ZswapCoinPublicKey>;
}

// owner related state
export ledger owner: ZswapCoinPublicKey;
export ledger pendingOwner: ZswapCoinPublicKey;
export ledger mergeWorker: ZswapCoinPublicKey;


export struct TokenPairInfo {
  fromChainId: Uint<32>;
  toChainId: Uint<32>;
  // fromAccount: Either<Bytes<32>, Opaque<"string">>;
  // toAccount: Either<Bytes<32>, Opaque<"string">>;
  midnigthTokenAccount: Bytes<32>;
  fee: Uint<128>; 
}


export struct CrossOutBound {
  smgId: Bytes<32>;
  fromAddr: ZswapCoinPublicKey;
  toAddr: Opaque<"string">;
  tokenPairId: Uint<32>;
  amount: Uint<128>;
  fee: Uint<128>;
  nonce: Uint<128>; // equal to crossCounter
}

export struct CrossProposal{
  smgId: Bytes<32>;
  token: Bytes<32>;
  isMappingToken: Boolean;
  amount: Uint<128>;
  fee: Uint<128>;
  toAddr: ZswapCoinPublicKey;
  ttl: Uint<128>;
}


constructor(
  adminThresholdInit: Uint<8>
  , smgPKThresholdInit: Uint<8>
) {
    owner = ownPublicKey();
    mergeWorker = ownPublicKey();
    tokenManager = ownPublicKey();
    feeReceiver = ownPublicKey();
    adminThreshold = disclose(adminThresholdInit);
    smgPKThreshold = disclose(smgPKThresholdInit);
    proposalId.increment(1);
}

// export circuit userLock(smgId: Bytes<32>, toAddr: Opaque<"string">, tokenPairId: Uint<32>, amount: Uint<128>): [] {
export circuit userLock(smgId: Bytes<32>, toAddr: Opaque<"string">, tokenPairId: Uint<32>, coin: CoinInfo): [] {
  assert(tokenPairs.member(disclose(tokenPairId)),"tokenpairId not exists");
  const tokenPair = tokenPairs.lookup(disclose(tokenPairId));
  assert(tokenPair.midnigthTokenAccount == disclose(coin.color), "token color not match");

  const contractFee = getFee(disclose(tokenPairId));
  // nonce = evolveNonce(crossCounter,nonce);

  // const nativeTokenColor = nativeToken();
  // if(nativeTokenColor == tokenPair.midnigthTokenAccount){
  //   nativeTokenReceived = (disclose(amount) + contractFee) as Uint<128>;
  // }else{
  //   nativeTokenReceived = contractFee;
  //   //check the type and amount of token received
  //   const coin = CoinInfo{color: tokenPair.midnigthTokenAccount, value: disclose(amount), nonce: nonce};
  //   receive(coin);
  //   addTreasuryCoin(coin);
  // }
  
  // if(nativeTokenReceived > 0){
  //   const nativeTokenCoin = CoinInfo{ color: nativeTokenColor, value: nativeTokenReceived, nonce: nonce};
  //   receive(nativeTokenCoin);
  //   addTreasuryCoin(nativeTokenCoin);
  // }

  if(contractFee > 0){
    accumulateFee(false,nativeToken(), contractFee);
    // const nativeTokenCoin = CoinInfo{ color: nativeToken(), value: contractFee, nonce: nonce};
    // receive(nativeTokenCoin);
    // addTreasuryCoin(nativeTokenCoin);
  }

  // const coin = CoinInfo{color: tokenPair.midnigthTokenAccount, value: disclose(amount), nonce: nonce};
  // receive(coin);
  // addTreasuryCoin(coin);
  receive(disclose(coin));
  addTreasuryCoin(disclose(coin));

  // record the crosschain info
  latestOutBoundCrosstxInfo = CrossOutBound{
    smgId: disclose(smgId)
    , fromAddr: ownPublicKey()
    , toAddr: disclose(toAddr)
    , tokenPairId: disclose(tokenPairId)
    , amount: disclose(coin.value)
    , fee: contractFee 
    , nonce: crossCounter as Field as Uint<128>
  };

  // crossCounter.increment(1);
}

circuit addCrossProposal(
  uniqueId: Bytes<32>
  , smgId: Bytes<32>
  , tokenPairId: Uint<32>
  , amount: Uint<128>
  , toAddr: ZswapCoinPublicKey
  , fee: Uint<128>
  , ttl: Uint<128>
  , isMappingToken: Boolean
): [] {
  assert(smgTxSigners.member(ownPublicKey()), "not smg member");
  assert(!crossProposal.member(disclose(uniqueId)), "proposal already exists");
  assert( disclose(ttl) >= crossCounter, "ttl expired");
  assert(tokenPairs.member(disclose(tokenPairId)),"tokenpairId not exists");

  const tokenPair = tokenPairs.lookup(disclose(tokenPairId));
  
  const newCrossProposal = CrossProposal{ 
    smgId: disclose(smgId)
    , token: tokenPair.midnigthTokenAccount
    , isMappingToken: isMappingToken
    , amount: disclose(amount)
    , fee: disclose(fee)
    , toAddr: disclose(toAddr)
    , ttl: disclose(ttl)
    };

  //TODO: need to check add the same proposal again
 
  crossProposal.insert(disclose(uniqueId),newCrossProposal);
  crossProposalVoters.insert(disclose(uniqueId),default<Set<Uint<8>>>);
  crossCounter.increment(1);
}

export circuit smgRelease(
  uniqueId: Bytes<32>
  , smgId: Bytes<32>
  , tokenPairId: Uint<32>
  , amount: Uint<128>
  , toAddr: ZswapCoinPublicKey
  , fee: Uint<128>
  , ttl: Uint<128>): [] {
  
  addCrossProposal(disclose(uniqueId), disclose(smgId), disclose(tokenPairId), disclose(amount), disclose(toAddr), disclose(fee), disclose(ttl), false);
}

// export circuit userBurn(smgId: Bytes<32>, toAddr: Opaque<"string">, tokenPairId: Uint<32>, amount: Uint<128>): [] {
export circuit userBurn(smgId: Bytes<32>, toAddr: Opaque<"string">, tokenPairId: Uint<32>, coin: CoinInfo): [] {
  assert(tokenPairs.member(disclose(tokenPairId)),"tokenpairId not exists");
  const tokenPair = tokenPairs.lookup(disclose(tokenPairId));
  assert(tokenPair.midnigthTokenAccount == disclose(coin.color), "token color not match");

  const contractFee = getFee(disclose(tokenPairId));
  
  // nonce = evolveNonce(crossCounter as Field as Uint<64>,nonce);
  // const coin = CoinInfo{color: tokenPair.midnigthTokenAccount, value: disclose(amount), nonce: nonce};
  // receive(coin);
  // sendImmediate(coin, burnAddress(), coin.value);
  receive(disclose(coin));
  sendImmediate(disclose(coin), burnAddress(), disclose(coin.value));

    // record the crosschain info
  latestOutBoundCrosstxInfo = CrossOutBound{
    smgId: disclose(smgId)
    , fromAddr: ownPublicKey()
    , toAddr: disclose(toAddr)
    , tokenPairId: disclose(tokenPairId)
    , amount: disclose(coin.value)
    , fee: contractFee
    , nonce: crossCounter as Field as Uint<128>
  };

  if(contractFee > 0){
    // receive(CoinInfo{ color: nativeToken(), value: contractFee, nonce: nonce});
    accumulateFee(false,nativeToken(), contractFee);
  }

  // crossCounter.increment(1);
}

export circuit smgMint(uniqueId: Bytes<32>
  , smgId: Bytes<32>
  , tokenPairId: Uint<32>
  , amount: Uint<128>
  , fee: Uint<128>
  , toAddr: ZswapCoinPublicKey
  , ttl: Uint<128>): [] {
  addCrossProposal(disclose(uniqueId), disclose(smgId), disclose(tokenPairId), disclose(amount), disclose(toAddr), disclose(fee), disclose(ttl), true);
}

circuit accumulateFee(isMappingToken: Boolean,token: Bytes<32>, fee: Uint<128>): [] {
  if(accFeeOfAllToken.member(disclose(token))) {
    const accFee = accFeeOfAllToken.lookup(disclose(token));
    const accAmount = accFee.totalFee + disclose(fee);
    accFeeOfAllToken.remove(disclose(token));
    accFeeOfAllToken.insert(disclose(token), AccFeeOfToken{isMappingToken:disclose(isMappingToken), totalFee: accAmount as Uint<128>});
  }else{
    accFeeOfAllToken.insert(disclose(token),AccFeeOfToken{isMappingToken:disclose(isMappingToken), totalFee: disclose(fee)});
  }
}

export circuit voteMultiCrossProposal(uniqueIds: Vector<3, Bytes<32>>): [] {
  for (const uniqueId of disclose(uniqueIds)) {
    if(uniqueId != default<Bytes<32>>) {
      voteCrossProposal(uniqueId);
    }
  }
}

export circuit voteCrossProposal(uniqueId: Bytes<32>): [] {
  assert(smgTxSigners.member(ownPublicKey()), "not smg member");
  assert(crossProposal.member(disclose(uniqueId)), "proposal not exists");

  const proposal = crossProposal.lookup(disclose(uniqueId));
  assert(proposal.ttl > crossCounter, "ttl expired");

  // const voters = crossProposalVoters.lookup(disclose(uniqueId));
  assert(crossProposalVoters.lookup(disclose(uniqueId)).size() < smgPKThreshold, "already passed");

  const voterIndex = smgTxSigners.lookup(ownPublicKey());
  assert(!crossProposalVoters.lookup(disclose(uniqueId)).member(voterIndex), "already voted");

  crossProposalVoters.lookup(disclose(uniqueId)).insert(voterIndex);

  if(crossProposalVoters.lookup(disclose(uniqueId)).size() >= smgPKThreshold && proposal.fee > 0){
    accumulateFee(proposal.isMappingToken,proposal.token,proposal.fee);
  }
}


export circuit executeCrossProposalOfNativeToken(uniqueId: Bytes<32>, coinIndex: Uint<128>): [] {
  assert(mergeWorker == ownPublicKey(), "only mergeWorker can executeCrossProposal ");
  assert( crossProposal.member(disclose(uniqueId)),"crossproposal not exists");
  assert(crossProposalVoters.lookup(disclose(uniqueId)).size() >= smgPKThreshold, "not enough votes");
  const proposal = crossProposal.lookup(disclose(uniqueId));
  assert( proposal.isMappingToken == false, "only native token can be executed");

  // const coinInput = treasuryCoins.lookup(disclose(coinIndex));
  assert(treasuryCoins.lookup(disclose(coinIndex)).value == proposal.amount, "coin value not match");
  const resultSend = send(treasuryCoins.lookup(disclose(coinIndex)), left<ZswapCoinPublicKey, ContractAddress>(disclose(proposal.toAddr)), proposal.amount);
  // if(resultSend.change.is_some) {addTreasuryCoin(resultSend.change.value);}

  crossProposalHis.insert(disclose(uniqueId),crossProposal.lookup(disclose(uniqueId)).ttl);
  crossProposal.remove(disclose(uniqueId));
  crossProposalVoters.remove(disclose(uniqueId));
  currentExecuteCrossProposal = disclose(uniqueId);
}
export circuit executeCrossProposalOfMappingToken(uniqueId: Bytes<32>): [] {
  // assert(mergeWorker == ownPublicKey(), "only mergeWorker can executeCrossProposal ");
  assert( crossProposal.member(disclose(uniqueId)),"crossproposal not exists");
  assert(crossProposalVoters.lookup(disclose(uniqueId)).size() >= smgPKThreshold, "not enough votes");
  const proposal = crossProposal.lookup(disclose(uniqueId));
  assert( proposal.isMappingToken == true, "only mappint token can be executed");

  nonce = evolveNonce(crossCounter as Field as Uint<64>,nonce);
  mintToken(proposal.token, proposal.amount as Uint<64>, nonce,left<ZswapCoinPublicKey, ContractAddress>(disclose(proposal.toAddr)));

  crossProposalHis.insert(disclose(uniqueId),crossProposal.lookup(disclose(uniqueId)).ttl);
  crossProposal.remove(disclose(uniqueId));
  crossProposalVoters.remove(disclose(uniqueId));
  currentExecuteCrossProposal = disclose(uniqueId);
  
}

export circuit transferFeeOfNativeToken(token: Bytes<32>,coinIndex: Uint<128>): [] {
  assert(accFeeOfAllToken.member(disclose(token)), "fee of specified token not exists");
  const feeInfo = accFeeOfAllToken.lookup(disclose(token));
  assert(feeInfo.isMappingToken == false, "only native token can be executed");

  const coinInput = treasuryCoins.lookup(disclose(coinIndex));
  assert(coinInput.value == feeInfo.totalFee, "coin value not match");
  const resultSend = send(coinInput, left<ZswapCoinPublicKey, ContractAddress>(feeReceiver), feeInfo.totalFee);
  // if(resultSend.change.is_some) {addTreasuryCoin(resultSend.change.value);}

  // if(feeInfo.isMappingToken){
  //   nonce = evolveNonce(crossCounter as Field as Uint<64>,nonce);
  //   mintToken(disclose(token), feeInfo.totalFee as Uint<64>, nonce,left<ZswapCoinPublicKey, ContractAddress>(feeReceiver));
  // }else{
    
  // }
}


circuit addTreasuryCoin(coin: CoinInfo): [] {
    // index 0 is reserved for invalid cion
  treasuryCoinCounter.increment(1);
  treasuryCoins.insertCoin(treasuryCoinCounter as Field as Uint<128>, coin, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  
}

// if fee is 0 ,cross fee is specified by feeConfig
circuit getFee(tokenPairId: Uint<32>): Uint<128> {
  const tokenPair = tokenPairs.lookup(disclose(tokenPairId));
  if(tokenPair.fee == 0) {
    if(feeCommonConfig.member(tokenPair.toChainId)){
      return feeCommonConfig.lookup(tokenPair.toChainId);
    }else {
      return 0;
    }
  } else {
    return tokenPair.fee;
  }
}


//-------------------------------------------------------------------------------------------------------------------
export circuit transferOwner(newOwner: ZswapCoinPublicKey): [] {
  assert(owner == ownPublicKey(), "only owner can transfer ownership");
  pendingOwner = disclose(newOwner);
}

export circuit acceptOwner(): [] {
  assert(pendingOwner == ownPublicKey(), "only pending owner can accept ownership");
  owner = pendingOwner;
}

export circuit setFeeReceiver(newFeeReceiver: ZswapCoinPublicKey): [] {
  assert(checkAdminAuthorized(), "not admin authorized");
  feeReceiver = disclose(newFeeReceiver);
}

export circuit setTokenManager(newTokenManager: ZswapCoinPublicKey): [] {
  assert(checkAdminAuthorized(), "not admin authorized");
  tokenManager = disclose(newTokenManager);
}

export circuit setMegerWorker(newMergeWorker: ZswapCoinPublicKey): [] {
  assert(checkAdminAuthorized(), "not admin authorized");
  mergeWorker = disclose(newMergeWorker);
}

export circuit test(coin0: QualifiedCoinInfo,coin1: QualifiedCoinInfo):[] {
  // const resultSend = send(disclose(coin), left<ZswapCoinPublicKey, ContractAddress>(disclose(feeReceiver)), 100000);
  // if(resultSend.change.is_some) {addTreasuryCoin(resultSend.change.value);}
  const coinInfo = mergeCoin(disclose(coin0), disclose(coin1));
}

export circuit mergeTreasuryCoin(coins: Vector<2,Uint<128>>): [] {
  assert(mergeWorker == ownPublicKey(), "only mergeWorker can merge coin");
  assert(treasuryCoins.member(disclose(coins[0])), "coin 0 not exists");
  assert(treasuryCoins.member(disclose(coins[1])), "coin 1 not exists");

  const coin0 = treasuryCoins.lookup(disclose(coins[0]));
  const coin1 = treasuryCoins.lookup(disclose(coins[1]));
  const coinInfo = mergeCoin(disclose(coin0), disclose(coin1));
  treasuryCoins.remove(disclose(coins[0]));
  treasuryCoins.remove(disclose(coins[1]));
  addTreasuryCoin(coinInfo);
}

export circuit addAdmin(admin: ZswapCoinPublicKey): [] {
  assert(checkAdminAuthorized(), "not admin authorized");
  assert(!admins.member(disclose(admin)), "admin already exists");
  admins.insert(disclose(admin),true);
}

export circuit removeAdmin(admin: ZswapCoinPublicKey): [] {
  assert(checkAdminAuthorized(), "not admin authorized");
  assert(admins.member(disclose(admin)), "admin does not exist");
  admins.remove(disclose(admin));
}

export circuit setAdminThreshold(threshold: Uint<8>): [] {
  assert(checkAdminAuthorized(), "not admin authorized");
  assert(disclose(threshold) <= admins.size(), "threshold must be less than or equal to the number of admins");
  adminThreshold = disclose(threshold);
}



export circuit setSmgPksks(voters: Vector<2,ZswapCoinPublicKey>): [] {
  assert(owner == ownPublicKey(), "only owner can set smg pks");
  smgTxSigners.resetToDefault();

  fold( (index: Uint<8>, voter: ZswapCoinPublicKey) =>{
    assert(!smgTxSigners.member(voter), "smg voter Repeatedly adding");
    smgTxSigners.insert(disclose(voter),index);
    return (index + 1) as Uint<8>;
  }, 0, disclose(voters));
}

export circuit updateSmgPk(newVoter: ZswapCoinPublicKey): [] {
  assert(smgTxSigners.member(ownPublicKey()), "voter does not exist");
  assert(!smgTxSigners.member(disclose(newVoter)), "the new voter exist");
  const index = smgTxSigners.lookup(ownPublicKey());

  smgTxSigners.remove(disclose(ownPublicKey()));
  smgTxSigners.insert(disclose(newVoter),index);
}

circuit checkAdminAuthorized(): Boolean {
  const isOwner = owner == ownPublicKey();
  const isAdminAuthorized = proposalVoters.member(currentExcuteProposalId)? proposalVoters.lookup(currentExcuteProposalId).size() >= adminThreshold : false;
  return ((isOwner && adminThreshold == 0) || isAdminAuthorized);
}

export circuit setSmgPKThreold(threshold: Uint<8>): [] {
  assert(checkAdminAuthorized(), "not admin authorized");
  assert(threshold <= smgTxSigners.size(), "threshold must be less than or equal to the number of smg pks");
  smgPKThreshold = disclose(threshold);
}

export circuit setFeeCommonConfig(chainId: Uint<32>, fee: Uint<128>): [] {
  assert(checkAdminAuthorized(), "not admin authorized");
  if(feeCommonConfig.member(disclose(chainId))) {
    feeCommonConfig.remove(disclose(chainId));
  } 
  feeCommonConfig.insert(disclose(chainId), disclose(fee));
}

export circuit addTokenPair(
  tokenPairId: Uint<32>
  , pairInfo: TokenPairInfo): [] {
  assert(tokenManager == ownPublicKey() || checkAdminAuthorized(), "not authorized");
  assert(!tokenPairs.member(disclose(tokenPairId)), "token pair already exists");
  tokenPairs.insert(disclose(tokenPairId), disclose(pairInfo));
}

export circuit removeTokenPair(tokenPairId: Uint<32>): [] {
  assert(tokenManager == ownPublicKey() || checkAdminAuthorized(), "not authorized");
  assert(tokenPairs.member(disclose(tokenPairId)), "token pair does not exist");
  tokenPairs.remove(disclose(tokenPairId));
}

export circuit newProposal(newProposal: Proposal): [] {
  proposals.insert(proposalId as Field as Uint<32>, disclose(newProposal));
  proposalVoters.insertDefault(proposalId as Field as Uint<32>);
  voteProposal(proposalId as Field as Uint<32>);
  proposalId.increment(1);
}

export circuit voteProposal(proposalId: Uint<32>): [] {
  assert(admins.member(ownPublicKey()), "only admin can vote proposal");
  assert(proposals.member(disclose(proposalId)), "proposal does not exist");
  // assert(proposalVoters.lookup(disclose(proposalId)).member(ownPublicKey()), "already voted");

  proposalVoters.lookup(disclose(proposalId)).insert(ownPublicKey());
}

 
export circuit executeProposal(proposalId: Uint<32>): [] {
  assert(proposalVoters.member(disclose(proposalId)), "proposal does not exist");
  currentExcuteProposalId = disclose(proposalId);


  const currentProposal = proposals.lookup(currentExcuteProposalId);
  if(currentProposal.type == ProposalType.AddAdmin){
    addAdmin(currentProposal.addr);
  }else if(currentProposal.type == ProposalType.RemoveAdmin){
    removeAdmin(currentProposal.addr);
  }else if(currentProposal.type == ProposalType.UpdateFeeReceiver){
    setFeeReceiver(currentProposal.addr);
  }else if(currentProposal.type == ProposalType.UpdateTokenManager){
    setTokenManager(currentProposal.addr);
  }else if(currentProposal.type == ProposalType.UpdateAdminThreshold){
    setAdminThreshold(currentProposal.threshold as Uint<8>);
  }else if(currentProposal.type == ProposalType.UpdateSMGPKThreshold){
    setSmgPKThreold(currentProposal.threshold as Uint<8>);
  }else if(currentProposal.type == ProposalType.UpdateFeeCommonConfig){
    setFeeCommonConfig(currentProposal.feeConfig.chainId as Uint<32>, currentProposal.feeConfig.fee as Uint<128>);
  }else if(currentProposal.type == ProposalType.SetSmgPKS){
    setSmgPksks(currentProposal.smgPubkeys);
  }

  proposals.remove(disclose(proposalId));
  proposalVoters.remove(disclose(proposalId));
}


